{
  "info": {
    "name": "EcoTour AI — Batam Eco-Tourism (Revisi)",
    "description": "Koleksi API EcoTour AI Batam — MF-001 s.d. MF-017 (F-001 s.d. F-049).\n\nFitur Utama:\n- Autentikasi & Akun\n- Widget Cuaca & Prakiraan Batam\n- Trip Unggulan (Featured Trips)\n- Direktori Destinasi & Akomodasi\n- Rating & Eco Score Otomatis (3 aspek: Kebersihan 35%, Lingkungan 40%, Kepedulian 25%)\n- Rute Feri (SG/MY -> Batam)\n- AI Smart Itinerary (Gemini)\n- Chat AI Terintegrasi & Rollback Versi\n- Carbon Calculator & Carbon Offset\n- Trip Collaboration & Notifikasi",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" }
  ],
  "item": [
    {
      "name": "🏥 Health Check",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health"
          }
        }
      ]
    },
    {
      "name": "🔐 Auth (MF-001)",
      "item": [
        {
          "name": "Register (Wisatawan) — F-001",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) { pm.environment.set('token', json.token); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Senja Pratiwi\",\n  \"email\": \"senja.tourist@email.com\",\n  \"password\": \"123456\",\n  \"role\": \"tourist\"\n}"
            },
            "url": "{{base_url}}/auth/register"
          }
        },
        {
          "name": "Register (Admin Destinasi & Kuliner)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) { pm.environment.set('token', json.token); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pengelola Mangrove Rempang\",\n  \"email\": \"admin.destinasi@email.com\",\n  \"password\": \"123456\",\n  \"role\": \"business_destination\"\n}"
            },
            "url": "{{base_url}}/auth/register"
          }
        },
        {
          "name": "Register (Admin Penginapan & Hotel)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) { pm.environment.set('token', json.token); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Manajemen Eco Bay Resort\",\n  \"email\": \"admin.hotel@email.com\",\n  \"password\": \"123456\",\n  \"role\": \"business_accommodation\"\n}"
            },
            "url": "{{base_url}}/auth/register"
          }
        },
        {
          "name": "Login — F-002",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) { pm.environment.set('token', json.token); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"senja@email.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": "{{base_url}}/auth/login"
          }
        },
        {
          "name": "Forgot Password — F-003",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"senja@email.com\"\n}"
            },
            "url": "{{base_url}}/auth/forgot-password"
          }
        },
        {
          "name": "Reset Password — F-003",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"PASTE_TOKEN_DISINI\",\n  \"new_password\": \"newpassword123\"\n}"
            },
            "url": "{{base_url}}/auth/reset-password"
          }
        },
        {
          "name": "Logout — F-035",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.environment.set('token', '');",
                  "console.log('Token dibersihkan dari environment');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/logout",
            "description": "Keluar dari akun dan otomatis menghapus token dari Postman Environment."
          }
        }
      ]
    },
    {
      "name": "👤 Kelola Akun (MF-002)",
      "item": [
        {
          "name": "Get Profile",
          "request": { "method": "GET", "url": "{{base_url}}/user/me" }
        },
        {
          "name": "Change Password — F-004",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"old_password\": \"123456\",\n  \"new_password\": \"newpassword123\"\n}"
            },
            "url": "{{base_url}}/user/password"
          }
        },
        {
          "name": "Change Email — F-005",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"new_email\": \"senja.baru@email.com\"\n}"
            },
            "url": "{{base_url}}/user/email"
          }
        },
        {
          "name": "Get Preferences — F-006",
          "request": { "method": "GET", "url": "{{base_url}}/user/preferences" }
        },
        {
          "name": "Update Preferences — F-006",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"language\": \"id\",\n  \"interests\": [\"nature\", \"culinary\", \"culture\", \"adventure\", \"shopping\", \"relaxation\"]\n}"
            },
            "url": "{{base_url}}/user/preferences"
          }
        }
      ]
    },
    {
