            "url": "{{base_url}}/carbon-offset"
          }
        },
        {
          "name": "Riwayat Donasi Saya",
          "request": { "method": "GET", "url": "{{base_url}}/carbon-offset/my" }
        }
      ]
    },
    {
      "name": "👥 Trip Collaboration (MF-010)",
      "item": [
