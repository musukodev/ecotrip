    {
      "name": "⭐ Rating & Eco Score Otomatis (MF-007)",
      "item": [
        {
          "name": "Kirim Rating 3 Aspek — F-026, F-027",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"target_type\": \"destination\",\n  \"target_id\": 1,\n  \"cleanliness\": 5,\n  \"environmental_condition\": 4,\n  \"environmental_care\": 5,\n  \"review_comment\": \"Sangat bersih dan perahu listriknya tidak mencemari air mangrove!\"\n}"
            },
            "url": "{{base_url}}/ratings",
            "description": "Bobot otomatis: Kebersihan 35%, Kondisi Lingkungan 40%, Kepedulian 25%."
          }
        },
        {
          "name": "Lihat Ulasan & Eco Score Target — F-028",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{base_url}}/ratings?target_type=destination&target_id=1"
          }
        }
      ]
    },
    {
      "name": "🚢 Estimasi Biaya Feri (MF-017)",
      "item": [
        {
          "name": "Rute Feri dari Singapura/Malaysia — F-047",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{base_url}}/ferry/routes?origin_country=singapore"
          }
        },
        {
          "name": "Detail Rute Feri",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{base_url}}/ferry/routes/1"
          }
        }
      ]
    },
    {
      "name": "🗺️ Trips & AI Itinerary Generator (MF-003)",
      "item": [
        {
          "name": "Buat Itinerary AI (Batam + Feri Asal) — F-007..F-010",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.trip && json.trip.id) { pm.environment.set('trip_id', json.trip.id.toString()); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Liburan Hijau Batam 3D2N\",\n  \"origin_country\": \"singapore\",\n  \"origin_port\": \"HarbourFront\",\n  \"duration_days\": 3,\n  \"pax\": 2,\n  \"budget\": 4000000,\n  \"interests\": [\"nature\", \"culinary\"],\n  \"start_date\": \"2026-09-12\",\n  \"end_date\": \"2026-09-14\"\n}"
            },
            "url": "{{base_url}}/trips"
          }
        },
        {
          "name": "List My Trips",
          "request": { "method": "GET", "url": "{{base_url}}/trips" }
        },
        {
          "name": "Trip Full Itinerary — F-011",
          "request": { "method": "GET", "url": "{{base_url}}/trips/{{trip_id}}/full" }
        },
        {
          "name": "Regenerate Itinerary — F-009",
          "request": { "method": "POST", "url": "{{base_url}}/trips/{{trip_id}}/generate" }
        },
        {
          "name": "Hentikan / Ubah Status Trip (archived/cancelled/completed)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"archived\"\n}"
            },
            "url": "{{base_url}}/trips/{{trip_id}}/status",
            "description": "Pilihan status: archived | cancelled | completed | active"
          }
        },
        {
          "name": "Laporan Jejak Karbon — F-018, F-019",
          "request": { "method": "GET", "url": "{{base_url}}/trips/{{trip_id}}/carbon" }
        },
        {
          "name": "Sustainability Score Trip — F-021",
          "request": { "method": "GET", "url": "{{base_url}}/trips/{{trip_id}}/score" }
        }
      ]
    },
    {
      "name": "💬 Chat AI & Versi (MF-004, F-016)",
      "item": [
        {
          "name": "Riwayat Chat AI — F-012",
          "request": { "method": "GET", "url": "{{base_url}}/trips/{{trip_id}}/chat" }
        },
        {
          "name": "Kirim Pesan Revisi Itinerary — F-013, F-015",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"revisi hari ke-2, ganti makan siang ke Warung Mie Sagu Bu Nur\"\n}"
            },
            "url": "{{base_url}}/trips/{{trip_id}}/chat"
          }
        },
        {
          "name": "Daftar Riwayat Versi Itinerary — F-016",
          "request": { "method": "GET", "url": "{{base_url}}/trips/{{trip_id}}/versions" }
        },
        {
          "name": "Rollback Versi Itinerary — F-016",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": 1\n}"
            },
            "url": "{{base_url}}/trips/{{trip_id}}/versions/rollback"
          }
        }
      ]
    },
    {
      "name": "🌱 Carbon Offset (F-020)",
